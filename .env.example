# Copy this file to .env and fill in real values. .env is gitignored - never commit real secrets.

# Notion internal integration token (Settings > Connections > Develop or Manage integrations)
NOTION_TOKEN=

# The Notion "data source" id backing the target database (not the page URL id).
# Find it via: POST https://api.notion.com/v1/search with {"filter":{"value":"data_source","property":"object"}}
NOTION_DATA_SOURCE_ID=

# Optional: kept for reference, not used directly by log-task.js
NOTION_DATABASE_ID=

NOTION_VERSION=2025-09-03
