<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Certification Bank Admin</label>
    <description>Full create/read/edit/delete access to the Certification question bank objects (Certification and Certification Question), for admins who maintain the multi-certification exam content library.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <objectPermissions>
        <object>Certification__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>true</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Certification_Question__c</object>
        <allowCreate>true</allowCreate>
